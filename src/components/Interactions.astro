---
// Site-wide motion: cursor glow + ring, card spotlight, scroll reveal, scroll progress,
// active nav link, terminal typing, count-up stats. All of it is skipped for
// prefers-reduced-motion, and the cursor effects only run on devices with a real mouse.
---

<div class="scroll-progress" aria-hidden="true"></div>
<div class="cursor-glow" aria-hidden="true"></div>
<div class="cursor-ring" aria-hidden="true"></div>
<div class="cursor-dot" aria-hidden="true"></div>

<style is:global>
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
    background: var(--accent);
    z-index: 60;
    pointer-events: none;
  }

  .cursor-glow,
  .cursor-ring,
  .cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .has-cursor .cursor-glow,
  .has-cursor .cursor-ring,
  .has-cursor .cursor-dot {
    opacity: 1;
  }
  .cursor-glow {
    width: 560px;
    height: 560px;
    margin: -280px 0 0 -280px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 14%, transparent) 0%, transparent 65%);
    z-index: 0;
  }
  [data-theme='light'] .cursor-glow {
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 10%, transparent) 0%, transparent 65%);
  }
  .cursor-ring {
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    z-index: 70;
    transition: opacity 0.3s ease, width 0.2s ease, height 0.2s ease, margin 0.2s ease, background-color 0.2s ease;
  }
  .cursor-ring.hovering {
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .cursor-ring.pressed {
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
  }
  .cursor-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    border-radius: 50%;
    background: var(--accent);
    z-index: 71;
  }
  main {
    position: relative;
    z-index: 1;
  }

  /* Card spotlight that follows the mouse */
  .card {
    position: relative;
    isolation: isolate;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 9%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: -1;
  }
  .card:hover::before {
    opacity: 1;
  }

  /* Scroll reveal (class added by script, so content stays visible without JS) */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--delay, 0ms);
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }

  /* Terminal typing caret */
  .term-body .caret {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
    }
    .cursor-glow,
    .cursor-ring,
    .cursor-dot {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    var root = document.documentElement;

    /* Scroll progress */
    function onScroll() {
      var h = document.documentElement.scrollHeight - window.innerHeight;
      root.style.setProperty('--progress', h > 0 ? String(window.scrollY / h) : '0');
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    /* Cursor glow + ring + dot */
    if (finePointer && !reduce) {
      var glow = document.querySelector('.cursor-glow');
      var ring = document.querySelector('.cursor-ring');
      var dot = document.querySelector('.cursor-dot');
      var mx = -100, my = -100, rx = -100, ry = -100, gx = -100, gy = -100;
      window.addEventListener('mousemove', function (e) {
        mx = e.clientX; my = e.clientY;
        document.body.classList.add('has-cursor');
      }, { passive: true });
      document.addEventListener('mouseleave', function () { document.body.classList.remove('has-cursor'); });
      window.addEventListener('mousedown', function () { ring.classList.add('pressed'); });
      window.addEventListener('mouseup', function () { ring.classList.remove('pressed'); });
      document.addEventListener('mouseover', function (e) {
        var t = e.target.closest && e.target.closest('a, button, .card');
        ring.classList.toggle('hovering', !!t);
      });
      (function loop() {
        rx += (mx - rx) * 0.22; ry += (my - ry) * 0.22;
        gx += (mx - gx) * 0.08; gy += (my - gy) * 0.08;
        dot.style.transform = 'translate3d(' + mx + 'px,' + my + 'px,0)';
        ring.style.transform = 'translate3d(' + rx + 'px,' + ry + 'px,0)';
        glow.style.transform = 'translate3d(' + gx + 'px,' + gy + 'px,0)';
        requestAnimationFrame(loop);
      })();

      /* Card spotlight position */
      document.addEventListener('mousemove', function (e) {
        var c = e.target.closest && e.target.closest('.card');
        if (!c) return;
        var r = c.getBoundingClientRect();
        c.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        c.style.setProperty('--my', (e.clientY - r.top) + 'px');
      }, { passive: true });
    }

    /* Scroll reveal with a small stagger inside each group */
    if (!reduce && 'IntersectionObserver' in window) {
      var groups = document.querySelectorAll('[data-reveal-group]');
      groups.forEach(function (g) {
        Array.prototype.forEach.call(g.querySelectorAll(':scope > *'), function (el, i) {
          el.classList.add('reveal');
          el.style.setProperty('--delay', Math.min(i * 80, 400) + 'ms');
        });
      });
      document.querySelectorAll('[data-reveal]').forEach(function (el) { el.classList.add('reveal'); });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
    }

    /* Active nav link */
    var links = document.querySelectorAll('.links a[href^="#"]');
    var map = {};
    links.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
    if ('IntersectionObserver' in window) {
      var current = null;
      var navIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) {
            if (current) current.classList.remove('active');
            current = map[en.target.id] || null;
            if (current) current.classList.add('active');
          }
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      ['about', 'experience', 'education', 'impact', 'skills', 'certifications', 'work', 'highlights', 'contact'].forEach(function (id) {
        var s = document.getElementById(id);
        if (!s) return;
        if (!map[id]) {
          var parentLink = { education: 'experience', impact: 'experience', skills: 'experience', certifications: 'experience', highlights: 'work' }[id];
          if (parentLink && map[parentLink]) map[id] = map[parentLink];
        }
        navIo.observe(s);
      });
    }

    /* Terminal typing */
    var term = document.querySelector('.term-body');
    if (term && !reduce) {
      var lines = Array.prototype.slice.call(term.children);
      var texts = lines.map(function (l) { return l.innerHTML; });
      lines.forEach(function (l) { l.style.visibility = 'hidden'; });
      var caret = document.createElement('span');
      caret.className = 'caret';
      var i = 0;
      function next() {
        if (i >= lines.length) { lines[lines.length - 1].appendChild(caret); return; }
        var l = lines[i];
        l.style.visibility = 'visible';
        var cmd = l.querySelector('.p');
        if (cmd) {
          var full = l.textContent.replace(/^\$\s*/, '');
          l.innerHTML = '<span class="p">$</span> ';
          var span = document.createElement('span');
          l.appendChild(span); l.appendChild(caret);
          var k = 0;
          (function type() {
            if (k <= full.length) { span.textContent = full.slice(0, k++); setTimeout(type, 38); }
            else { l.innerHTML = texts[i]; i++; setTimeout(next, 220); }
          })();
        } else {
          l.innerHTML = texts[i];
          i++;
          setTimeout(next, 90);
        }
      }
      setTimeout(next, 500);
    }

    /* Count-up numbers */
    var nums = document.querySelectorAll('[data-count]');
    if (nums.length && 'IntersectionObserver' in window) {
      var cio = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          cio.unobserve(en.target);
          var el = en.target;
          var target = parseFloat(el.getAttribute('data-count'));
          var pre = el.getAttribute('data-prefix') || '';
          var suf = el.getAttribute('data-suffix') || '';
          if (reduce) { el.textContent = pre + target + suf; return; }
          var start = null, dur = 1200;
          (function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts - start) / dur, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = pre + Math.round(target * eased) + suf;
            if (p < 1) requestAnimationFrame(step);
          })(performance.now());
        });
      }, { threshold: 0.6 });
      nums.forEach(function (n) { cio.observe(n); });
    }
  })();
</script>
