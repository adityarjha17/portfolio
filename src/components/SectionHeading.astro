---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}
const { index, title, subtitle } = Astro.props;
---

<div class="heading">
  <span class="index mono">{index}</span>
  <h2>{title}</h2>
  {subtitle && <p>{subtitle}</p>}
</div>

<style>
  .heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .index {
    font-size: 13px;
    color: var(--accent);
  }
  h2 {
    font-size: clamp(28px, 4vw, 32px);
    font-weight: 700;
  }
  p {
    margin: 0;
    color: var(--muted);
  }
</style>
