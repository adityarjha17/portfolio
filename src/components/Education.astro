---
import SectionHeading from './SectionHeading.astro';
import Logo from './Logo.astro';
import { education } from '../data/site';
---

<section id="education" class="section">
  <div class="container section-inner">
    <div data-reveal><SectionHeading index="03" title="Education" /></div>
    {
      education.map((e) => (
        <div class="card row" data-reveal>
          <Logo name={e.school} src={e.logo} />
          <div class="body">
            <h3>{e.degree}</h3>
            <p class="school">{e.school}</p>
            <p class="detail">{e.detail}</p>
          </div>
          <span class="date">{e.dates}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 6px 16px;
  }
  .body {
    flex: 1 1 260px;
    min-width: 0;
  }
  h3 {
    font-size: clamp(18px, 2.2vw, 21px);
    font-weight: 700;
    line-height: 1.3;
  }
  .school {
    margin: 4px 0 0;
    font-weight: 700;
    color: var(--accent-text);
  }
  .detail {
    margin: 4px 0 0;
    color: var(--muted);
  }
</style>
