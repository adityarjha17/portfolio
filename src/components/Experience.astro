---
import SectionHeading from './SectionHeading.astro';
import Logo from './Logo.astro';
import { roles } from '../data/site';

---

<section id="experience" class="experience">
  <div class="container inner">
    <div data-reveal><SectionHeading index="02" title="Experience" /></div>

    <ol class="list" data-reveal-group>
      {
        roles.map((r) => (
          <li class="card">
            <div class="head">
              <Logo name={r.company} src={r.logo} />
              <div class="title">
                <h3>{r.role}</h3>
                <p class="company">
                  {r.company}
                  {r.note && <span class="note"> · {r.note}</span>}
                </p>
              </div>
              <span class="date">{r.dates}</span>
            </div>
            <ul class="points">
              {r.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <div class="tags">
              {r.tags.map((t) => (
                <span class="tag mono">{t}</span>
              ))}
            </div>
          </li>
        ))
      }
    </ol>

  </div>
</section>

<style>
  .experience {
    padding: 56px 0 64px;
    border-top: 1px solid var(--border);
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .card {
    padding: 26px 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    border-color: var(--border-strong);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 6px 16px;
    margin-bottom: 14px;
  }
  .title {
    flex: 1 1 260px;
    min-width: 0;
  }
  h3 {
    font-size: clamp(18px, 2.2vw, 21px);
    font-weight: 700;
    line-height: 1.3;
  }
  .company {
    margin: 4px 0 0;
    font-weight: 700;
    color: var(--accent-text);
  }
  .note {
    font-weight: 500;
    color: var(--muted);
  }
  .dates {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }
  .points {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
  }
  .points li::marker {
    color: var(--accent-text);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .tag {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 12px;
    color: var(--text);
  }
  @media (max-width: 760px) {
    .card {
      padding: 20px 18px;
    }
    .points {
      font-size: 15px;
    }
  }
</style>
