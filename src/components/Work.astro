---
import SectionHeading from './SectionHeading.astro';
import { blogs } from '../data/site';
---

<section id="work" class="section">
  <div class="container section-inner">
    <div data-reveal>
      <SectionHeading index="07" title="Personal projects & blogs" subtitle="Writing on AI infrastructure, LLMs in production and cloud." />
    </div>
    <div class="grid" data-reveal-group>
      {
        blogs.map((b) =>
          b.url ? (
            <a class="card post" href={b.url} target="_blank" rel="noopener">
              <span class="mono label">
                {b.kind} · {b.date}
              </span>
              <h3>{b.title}</h3>
              {b.subtitle && <p>{b.subtitle}</p>}
              <span class="mono cta">read on Medium ↗</span>
            </a>
          ) : (
            <div class="post soon">
              <span class="mono label">{b.kind} · coming soon</span>
              <h3>{b.title}</h3>
              {b.subtitle && <p>{b.subtitle}</p>}
            </div>
          )
        )
      }
    </div>
    <a class="medium mono" href="https://medium.com/@jha.aditya17" target="_blank" rel="noopener">all posts on Medium ↗</a>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .post {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 190px;
    padding: 22px 24px;
    text-decoration: none;
    color: inherit;
  }
  a.post:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .soon {
    border: 1.5px dashed var(--border-strong);
    border-radius: 16px;
  }
  .label {
    font-size: 12px;
    color: var(--accent-text);
  }
  h3 {
    font-size: 19px;
    line-height: 1.3;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .cta {
    margin-top: auto;
    font-size: 13px;
    color: var(--accent-text);
  }
  .medium {
    align-self: flex-start;
    font-size: 14px;
    text-decoration: none;
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
